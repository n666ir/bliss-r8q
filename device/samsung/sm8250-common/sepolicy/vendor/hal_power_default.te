allow hal_power_default sysfs_batteryinfo:file { open write };
allow hal_power_default sysfs_devices_system_cpu:file write;
allow hal_power_default vendor_latency_device:chr_file { open write };
allow hal_power_default { vendor_sysfs_touchscreen vendor_sysfs_touchscreen_writable }:dir search;
allow hal_power_default { vendor_sysfs_touchscreen vendor_sysfs_touchscreen_writable }:file { getattr open read write };

allow hal_power_default vendor_sysfs_sensors:dir search;
allow hal_power_default vendor_sysfs_sensors:file { open write };

# Power HAL / powerhint
allow hal_power_default cgroup:dir search;
allow hal_power_default cgroup:file rw_file_perms;
allow hal_power_default sysfs_devices_system_cpu:file rw_file_perms;
set_prop(hal_power_default, vendor_power_prop);
